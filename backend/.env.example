# =================================================================
# KRATAMEX — Variables de entorno del backend
# Copia este archivo a .env y ajusta los valores
# =================================================================

# Credenciales de usuarios por defecto
ADMIN_USER=admin
ADMIN_PASS=[REMOVED_HISTORICAL_CREDENTIAL]
USER_STANDARD=user
USER_PASS=[REMOVED_HISTORICAL_CREDENTIAL]

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kratamex
DB_USER=kratamex
DB_PASSWORD=CAMBIAR_DB_PASS_LOCAL

# CORS — en producción cambia a tu dominio real
CORS_ORIGIN=https://localhost
